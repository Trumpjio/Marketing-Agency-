# OrcaPulse site — Apache config for Hostinger

# Default page
DirectoryIndex index.html index.php

# Compression — faster page loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching — faster repeat visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpg "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Block access to data files directly
<FilesMatch "\.(json|md)$">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Enforce HTTPS for one year (safe once your Hostinger SSL is live)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  # Modest Content-Security-Policy — tightened over time. 'unsafe-inline' kept
  # because inline styles are used throughout the design; move to nonces later.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.tiny.cloud; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://calendly.com; connect-src 'self' https:;"
  # Prevent the admin from loading inside a cross-origin iframe
  <FilesMatch "\.(php)$">
    Header set X-Frame-Options "DENY"
  </FilesMatch>
</IfModule>

# Block hidden/dotfiles like data/.auth.json, data/.recovery, data/.rate_*
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)
# Block direct access to admin internals
<FilesMatch "^(_|config\.php$)">
  Require all denied
</FilesMatch>

# Pretty URLs — drop .html extension (optional)
# RewriteEngine On
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME}.html -f
# RewriteRule ^(.+)$ $1.html [L]
